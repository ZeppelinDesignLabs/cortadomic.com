---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" noindex={true}>
  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-24 text-center">
    <h1 class="text-4xl font-bold text-brand-dark mb-4">Page Not Found</h1>
    <p class="text-gray-600 text-lg mb-8">Sorry, we couldn't find that page.</p>
    <a href="/" class="inline-block bg-brand-orange text-white px-8 py-3 rounded-full font-bold hover:bg-brand-orange-light transition-colors">
      Back to Home
    </a>
  </section>
</BaseLayout>
