---
import BaseLayout from '../layouts/BaseLayout.astro';
import Picture from '../components/Picture.astro';
import siteData from '../content/site.json';

const aboutLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: `About ${siteData.companyName}`,
  description: 'Zeppelin Design Labs designs and manufactures Cortado contact microphones in Naperville, Illinois.',
  url: `${siteData.siteUrl}/about/`,
  mainEntity: { '@id': `${siteData.siteUrl}/#organization` },
};
---

<BaseLayout
  title="About Zeppelin Design Labs"
  description="Zeppelin Design Labs builds Cortado contact microphones in Naperville, IL — professional piezo pickups for studio, stage, foley, and field recording since the original Cortado MkIII."
  ogImage="/images/og/og-home.jpg"
  jsonLd={aboutLd}
>
  <section class="relative text-white overflow-hidden">
    <div class="absolute inset-0 bg-brand-dark"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <p class="text-brand-orange font-bold text-sm uppercase tracking-widest mb-3">About Us</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-6 max-w-2xl">Zeppelin Design Labs</h1>
      <p class="text-gray-200 text-lg max-w-2xl leading-relaxed">
        We design and build the Cortado family of contact microphones — tools for musicians, sound designers, and engineers who want to hear what solid objects have to say.
      </p>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid lg:grid-cols-2 gap-12 items-start">
      <div class="space-y-6 text-gray-600 leading-relaxed">
        <p>
          Zeppelin Design Labs is based in Naperville, Illinois. For years we have supplied the audio and maker communities with DIY electronics kits, studio tools, and now the Cortado line of professional contact microphones.
        </p>
        <p>
          The <strong>Cortado MkIII</strong> established our reputation: a rugged, balanced XLR contact mic trusted in studios, on stages, and in high-profile installations — including more than 130 pickups under NBA basketball courts. The <strong>Cortado Xe</strong>, released in 2026, packs the same philosophy into the most compact pro housing we have ever built.
        </p>
        <p>
          Every Cortado is designed in-house, tested in real recording scenarios, and sold through authorized dealers worldwide. We stand behind our products with direct support from the team that builds them.
        </p>
        <p>
          Questions about products, dealers, or custom installations? Visit our <a href="/contact/" class="text-brand-orange font-semibold hover:underline">contact page</a> or email <a href={`mailto:${siteData.contactEmail}`} class="text-brand-orange font-semibold hover:underline">{siteData.contactEmail}</a>.
        </p>
      </div>
      <div>
        <Picture
          src="/images/logos/zeppelin-logo.png"
          alt="Zeppelin Design Labs logo"
          class="w-64 h-auto mx-auto mb-8"
        />
        <div class="bg-brand-light rounded-xl p-6 border border-gray-200">
          <h2 class="text-xl font-bold text-brand-dark mb-4">Lab location</h2>
          <p class="text-gray-700">{siteData.address}</p>
          <p class="text-gray-700 mt-2">
            <a href="https://www.zeppelindesignlabs.com" class="text-brand-orange font-semibold hover:underline">
              zeppelindesignlabs.com
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
