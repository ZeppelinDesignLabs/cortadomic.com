---
interface Props {
  quote: string;
  name: string;
  credit?: string;
  url?: string;
  storySlug?: string;
  size?: 'lg' | 'sm';
}

const { quote, name, credit, url, storySlug, size = 'lg' } = Astro.props;
const isLarge = size === 'lg';
---

<figure class:list={['text-center', isLarge ? 'max-w-3xl mx-auto' : '']}>
  <svg class:list={['mx-auto text-brand-orange mb-4', isLarge ? 'w-10 h-10' : 'w-7 h-7']} fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M9.983 3v7.391C9.983 16.095 6.252 19.961 1 21l-.995-2.151C2.437 17.932 4 15.211 4 13H0V3h9.983zM24 3v7.391c0 5.704-3.748 9.571-9 10.609l-.996-2.151C16.437 17.932 18 15.211 18 13h-3.983V3H24z" />
  </svg>
  <blockquote>
    <p class:list={['text-brand-dark font-semibold leading-snug', isLarge ? 'text-2xl md:text-3xl' : 'text-xl']}>
      &ldquo;{quote}&rdquo;
    </p>
  </blockquote>
  <figcaption class="mt-5">
    <p class="font-bold text-brand-dark">
      {url ? (
        <a href={url} target="_blank" rel="noopener" class="hover:text-brand-orange transition-colors">{name}</a>
      ) : (
        name
      )}
    </p>
    {credit && <p class="text-sm text-gray-500 mt-1">{credit}</p>}
    {storySlug && (
      <p class="mt-3">
        <a href={`/stories/${storySlug}/`} class="text-sm text-brand-orange font-semibold hover:underline">Read the story &rarr;</a>
      </p>
    )}
  </figcaption>
</figure>
