---
interface Props {
  heading?: string;
  blurb?: string;
}

const {
  heading = 'See how people really use their Cortado',
  blurb = 'From acoustic guitars to Porsche engines, explore real stories from the Cortado community — and share your own for a free Zeppelin Design Labs T-shirt.',
} = Astro.props;
---

<div class="bg-brand-dark text-white rounded-xl p-8 md:flex md:items-center md:justify-between gap-8">
  <div class="mb-6 md:mb-0">
    <p class="text-brand-orange font-bold text-sm uppercase tracking-widest mb-2">Caught on Cortado</p>
    <h2 class="text-2xl font-bold mb-2">{heading}</h2>
    <p class="text-gray-300 max-w-xl">{blurb}</p>
  </div>
  <div class="flex flex-wrap gap-3 shrink-0">
    <a
      href="/stories/"
      class="bg-brand-orange text-white px-7 py-3 rounded-full font-bold hover:bg-brand-orange-light transition-colors whitespace-nowrap"
    >
      See the stories
    </a>
    <a
      href="/share-your-cortado/"
      class="border-2 border-white text-white px-7 py-3 rounded-full font-bold hover:bg-white hover:text-brand-dark transition-colors whitespace-nowrap"
    >
      Share yours
    </a>
  </div>
</div>
